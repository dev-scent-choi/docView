# 의존성
node_modules/

# 업로드된 문서·변환본·감사 로그 (사용자 데이터 — 절대 커밋 금지)
data/

# 외부 변환 도구 바이너리 (README의 설치 안내 참조)
tools/

# 로그·임시 파일
*.log
.DS_Store
Thumbs.db

# 도구 캐시(소스 아님)
.impeccable/

# 빌드 산출물 (src/client/*.ts에서 npm run build:editor로 생성됨)
public/js/editor.bundle.js
public/js/editor.bundle.js.map
public/js/grid-editor.bundle.js
public/js/grid-editor.bundle.js.map
public/js/editor-slides.bundle.js
public/js/editor-slides.bundle.js.map
public/js/editor-hwp.bundle.js
public/js/editor-hwp.bundle.js.map
# splitting:true가 뽑아내는 공유 chunk(prosemirror/yjs 등 여러 편집기가 겹쳐 쓰는 코드) — 파일명이
# 빌드마다 content-hash로 바뀌어 소스가 아니다.
public/js/chunks/

# 외부 프로젝트(@rhwp/editor의 rhwp-studio) 미러 — tools/와 같은 이유로 커밋하지 않는다.
# node scripts/mirror-rhwp-studio.mjs로 받는다(README "한글(hwp/hwpx) 편집" 참고).
public/rhwp/

# 브라우저 회귀 테스트 산출물(스크린샷·샘플 업로드 파일) — 실행할 때마다 재생성됨
scripts/.screenshots/

# 운영 비밀값(DOCVIEW_SECRET/DOCVIEW_API_KEYS) — start.bat이 존재하면 불러온다.
# start.local.bat.example을 이 이름으로 복사해서 실제 값을 채운다(README "운영 실행" 참고).
# 이 파일 자체가 없으면(로컬 개발 등) start.bat이 경고만 남기고 임시 시크릿으로 계속 동작한다.
start.local.bat

# Claude Code 개인용 로컬 설정(권한 등) — 팀과 공유하지 않는다.
.claude/settings.local.json
