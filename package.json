{
  "name": "docview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "권한 제어형 문서 웹뷰어 — 모든 포맷을 서버에서 PDF/이미지로 정규화하여 열람, docx는 실시간 동시편집 지원",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run build:editor && tsx watch src/server.ts",
    "start": "npm run build:editor && tsx src/server.ts",
    "build:editor": "node scripts/build-editor.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "^8.0.0",
    "@fastify/websocket": "^11.0.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@rhwp/editor": "^0.8.6",
    "exceljs": "^4.4.0",
    "fast-formula-parser": "^1.0.19",
    "fast-xml-parser": "^4.5.0",
    "fastify": "^5.2.0",
    "fflate": "^0.8.3",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.2",
    "lib0": "^0.2.99",
    "orderedmap": "^2.1.1",
    "pdf-lib": "^1.17.1",
    "pdf-to-img": "^4.5.0",
    "pdfjs-dist": "4.2.67",
    "prosemirror-commands": "^1.6.2",
    "prosemirror-keymap": "^1.2.2",
    "prosemirror-model": "^1.24.1",
    "prosemirror-schema-list": "^1.5.0",
    "prosemirror-state": "^1.4.3",
    "prosemirror-tables": "^1.6.1",
    "prosemirror-transform": "^1.10.2",
    "prosemirror-view": "^1.36.0",
    "sharp": "^0.35.3",
    "y-prosemirror": "^1.2.15",
    "y-protocols": "^1.0.6",
    "y-websocket": "^2.0.4",
    "yjs": "^13.6.20"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.0.0",
    "esbuild": "^0.24.0",
    "playwright": "^1.62.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
